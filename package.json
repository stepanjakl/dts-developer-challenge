{
  "name": "hmcts-dts-task-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm run dev -w @tasks/api\" \"npm run dev -w @tasks/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "npm run db:generate -w @tasks/api",
    "db:migrate": "npm run db:migrate -w @tasks/api",
    "db:seed": "npm run db:seed -w @tasks/api",
    "db:studio": "npm run db:studio -w @tasks/api"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
