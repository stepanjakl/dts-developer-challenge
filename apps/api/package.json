{
  "name": "@tasks/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    "./test-database": "./src/testing/test-database.ts",
    "./*-contract": "./src/features/*/*.contract.ts",
    "./problem-details": "./src/errors/problem-details.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env.local src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=../../.env.local src/features/tasks/tasks.seed.ts",
    "db:studio": "drizzle-kit studio --port 4985"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1"
  }
}
